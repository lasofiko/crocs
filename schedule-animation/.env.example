# Связка с бэкендом (корень репо, порт 8000):
# 1) pip install -e .
# 2) crocs-api   или   python -m uvicorn crocs.api.app:app --host 127.0.0.1 --port 8000
# 3) npm run dev — запросы идут на /api, Vite проксирует на 127.0.0.1:8000
#
# Раскомментируйте, если бэк на другом хосте/порту (без прокси Vite):
# VITE_API_URL=http://127.0.0.1:8000
